# =============================================================================
# Janus-Ops — .gitignore
# Monorepo: backend (Python/FastAPI) · frontend (Next.js) · agent (Go)
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets & local configuration  (NEVER commit these)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!**/.env.example
*.local.yaml
*.local.yml
# notification channels and AI keys for local tests (deploy/.local)
.local
**/.local
secrets/
**/secrets/
master.key
*.vault
# TLS material / keys
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*
id_ecdsa*
!**/testdata/**/*.pem
# Agent enrollment tokens / generated agent configs
**/agent-config*.yaml
enrollment-tokens/

# -----------------------------------------------------------------------------
# Tooling / AI assistants
# -----------------------------------------------------------------------------
.claude/
graphify-out/

# -----------------------------------------------------------------------------
# Python (backend)
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.python-version
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
celerybeat-schedule*
celerybeat.pid

# -----------------------------------------------------------------------------
# Node / Next.js (frontend)
# -----------------------------------------------------------------------------
node_modules/
.pnpm-store/
.next/
out/
.turbo/
.vercel/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
storybook-static/
playwright-report/
test-results/
/blob-report/
/playwright/.cache/

# -----------------------------------------------------------------------------
# Go (janus-agent)
# -----------------------------------------------------------------------------
agent/bin/
agent/dist/
*.exe
*.exe~
*.dll
*.dylib
*.test
*.out
go.work
go.work.sum
# Precompiled agent bundles are release artifacts, not sources
**/agent-bundles/*
!**/agent-bundles/.gitkeep

# -----------------------------------------------------------------------------
# Runtime data (local dev)
# -----------------------------------------------------------------------------
/data/
*.db
*.sqlite
*.sqlite3
*.bbolt
*.bolt
pgdata/
redis-data/
# Ansible-runner artifacts & terminal session recordings
**/runner-data/artifacts/
*.retry
/recordings/
*.cast
/logs/
*.log

# -----------------------------------------------------------------------------
# Docker / deploy
# -----------------------------------------------------------------------------
docker-compose.override.yml
compose.override.yml
.docker/

# -----------------------------------------------------------------------------
# IDE / OS
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
