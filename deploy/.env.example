# =============================================================================
# Janus-Ops — environment reference
# Copy to deploy/.env with `make env` (generates the secrets for you).
# Role -> LDAP group mapping and permissions are managed in the UI (Users & roles).
# Secrets must be URL-safe (hex): POSTGRES_PASSWORD is embedded in a database URL.
# =============================================================================

# --- Image -------------------------------------------------------------------
# Image repository and tag used by deploy/compose.yaml
JANUS_IMAGE=lordraw77/janus-ops
JANUS_VERSION=0.1.0

# --- Public endpoint (Caddy) -------------------------------------------------
# Host name users type in the browser
JANUS_DOMAIN=localhost
# "internal" = self-signed cert from Caddy's local CA (air-gapped friendly),
# or an e-mail address to request a public certificate via ACME
JANUS_TLS=internal
# Host ports published by the proxy. With a non-default HTTPS port, open
# https://<domain>:<port>/ directly: the HTTP->HTTPS redirect targets port 443.
JANUS_HTTP_PORT=80
JANUS_HTTPS_PORT=443

# --- Application ---------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
JANUS_LOG_LEVEL=INFO
TZ=Etc/UTC

# --- Database (TimescaleDB) ----------------------------------------------------
# REQUIRED. Password of the "janus" database user
POSTGRES_PASSWORD=

# --- LDAP directory sidecar (lldap) --------------------------------------------
# Base DN of the directory
LDAP_BASE_DN=dc=janus-ops,dc=local
# REQUIRED. Random secrets used by lldap to sign tokens and derive keys
LLDAP_JWT_SECRET=
LLDAP_KEY_SEED=
# REQUIRED. Password of the lldap "admin" account (directory admin UI)
LLDAP_ADMIN_PASSWORD=
# Directory admin UI, bound to 127.0.0.1 only
LLDAP_UI_PORT=17170
# REQUIRED. Password of the read-only service account "janus-svc", created by the
# ldap-init job; Janus-Ops uses it to look up users and their groups
LDAP_BIND_PASSWORD=
# REQUIRED. Password of "janus-manager" (lldap_admin), created by the ldap-init job;
# Janus-Ops uses it to create and edit users and groups from the Users page
LDAP_MANAGER_PASSWORD=

# --- Sign-in -------------------------------------------------------------------
# Session lifetime and inactivity timeout, in seconds
JANUS_SESSION_TTL_S=28800
JANUS_SESSION_IDLE_S=3600
# Name of the local emergency admin (set its password: see README "Break-glass")
JANUS_BREAKGLASS_USERNAME=breakglass

# --- Initial administrator -----------------------------------------------------
# Created in the directory by the setup job at first start, member of janus-admins.
# Create-only: once it exists, changing these values has no effect (change the
# password from the Users page). Leave JANUS_ADMIN_PASSWORD empty to skip it.
JANUS_ADMIN_USERNAME=janus-admin
JANUS_ADMIN_PASSWORD=
JANUS_ADMIN_EMAIL=

# --- SSH bastion ----------------------------------------------------------------
# Terminal sessions are recorded (output only, asciicast v2) on the "recordings"
# volume. Set JANUS_RECORDINGS_DIR= (empty) to disable recording.
#JANUS_RECORDINGS_DIR=/var/lib/janus-ops/recordings
# Close a terminal after this many seconds without input
JANUS_TERMINAL_IDLE_S=1800
# Open terminals per user
JANUS_TERMINAL_MAX_PER_USER=10
# Largest file accepted by the SFTP browser, MiB
JANUS_SFTP_MAX_UPLOAD_MB=1024

# --- Agents --------------------------------------------------------------------
# URL the agents connect to (outbound HTTPS, port 443). Empty = the URL the operator
# uses in the browser when installing the agent. It must match the TLS certificate:
# with JANUS_TLS=internal, JANUS_DOMAIN must be this host name or IP address.
JANUS_AGENT_SERVER_URL=
# Telemetry interval, seconds (5-15); agents pick it up when they reconnect
JANUS_AGENT_INTERVAL_S=10

# --- Encryption ---------------------------------------------------------------
# REQUIRED. 64 hex chars (32 bytes): encrypts secrets at rest (TOTP seeds).
# Back it up with the database; changing it makes stored TOTP seeds unreadable.
JANUS_SECRET_KEY=

# -----------------------------------------------------------------------------
# Variables read by the janus-ops process itself (set by compose.yaml; listed
# here for reference when running the image without compose):
#   JANUS_DATABASE_URL         postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB  (required)
#   JANUS_LOG_LEVEL            DEBUG | INFO | WARNING | ERROR                  (INFO)
#   JANUS_HOST                 listen address                                 (0.0.0.0)
#   JANUS_PORT                 listen port                                    (8000)
#   JANUS_STATIC_DIR           exported web UI; unset = API only              (/app/static in the image)
#   JANUS_DB_CONNECT_TIMEOUT_S database connect timeout, seconds              (5)
#   JANUS_FORWARDED_ALLOW_IPS  proxies trusted for X-Forwarded-*              (127.0.0.1)
#   JANUS_LDAP_URL             ldap://host:port or ldaps://; unset = LDAP off (none)
#   JANUS_LDAP_BASE_DN         directory base DN                              (required with LDAP)
#   JANUS_LDAP_USER_BASE_DN    where users live                               (ou=people,<base>)
#   JANUS_LDAP_USER_FILTER     user search filter, must contain {username}
#                                                  ((&(objectClass=person)(uid={username})))
#   JANUS_LDAP_BIND_DN         read-only service account DN                   (required with LDAP)
#   JANUS_LDAP_BIND_PASSWORD   its password                                   (required with LDAP)
#   JANUS_LLDAP_HTTP_URL       lldap GraphQL endpoint; unset = users read-only (none)
#   JANUS_LDAP_MANAGER_USER    lldap account in lldap_admin                   (janus-manager)
#   JANUS_LDAP_MANAGER_PASSWORD its password                     (required with JANUS_LLDAP_HTTP_URL)
#   JANUS_ADMIN_USERNAME       initial administrator, created if missing      (janus-admin)
#   JANUS_ADMIN_PASSWORD       its password, min. 12 chars; unset = not created (none)
#   JANUS_ADMIN_EMAIL          its e-mail                          (<username>@janus-ops.invalid)
#   JANUS_SECRET_KEY           64 hex chars, encrypts TOTP seeds and the vault (none)
#   JANUS_RECORDINGS_DIR       terminal recordings directory; unset = off   (none)
#   JANUS_TERMINAL_IDLE_S      terminal inactivity timeout, seconds           (1800)
#   JANUS_TERMINAL_MAX_PER_USER open terminals per user                       (10)
#   JANUS_SSH_CONNECT_TIMEOUT_S SSH connect timeout, seconds                  (10)
#   JANUS_SFTP_MAX_UPLOAD_MB   SFTP upload limit, MiB                         (1024)
#   JANUS_SFTP_IDLE_S          close idle SFTP connections after, seconds     (300)
#   JANUS_AGENT_DIR            janus-agent-linux-<arch> binaries               (/app/agent in the image)
#   JANUS_AGENT_SERVER_URL     https:// URL agents connect to       (the URL used in the browser)
#   JANUS_AGENT_RELEASE_PUBLIC_KEY  public key of `janus-ops agent-keygen` (FR-84)    (unset: no self-update)
#   JANUS_AGENT_CA_FILE        CA (PEM) agents trust besides system CAs
#                                     (Caddy internal root, published by the proxy container)
#   JANUS_AGENT_INTERVAL_S     telemetry interval, seconds, 5-15              (10)
#   JANUS_AGENT_ENROLL_TTL_S   lifetime of a one-time enrollment token, s     (900)
#   JANUS_AGENT_BOOTSTRAP_WAIT_S wait for the agent to connect after install  (45)
#   JANUS_MONITORING_ENABLED   run checks and send notifications in this process (true)
#   JANUS_LDAP_TIMEOUT_S       connect/receive timeout, whole seconds         (5)
#   JANUS_LDAP_CA_FILE         CA bundle for ldaps:// servers                 (system CAs)
#   JANUS_SESSION_TTL_S        session lifetime, seconds                      (28800)
#   JANUS_SESSION_IDLE_S       inactivity timeout, seconds                    (3600)
#   JANUS_COOKIE_SECURE        send the session cookie over HTTPS only        (true)
#   JANUS_BREAKGLASS_USERNAME  local emergency admin name                     (breakglass)
#   JANUS_AI_BASE_URL          https:// OpenAI-compatible endpoint (self-hosted); unset = Copilot off
#   JANUS_AI_MODEL             model name sent to the endpoint                 (unset = Copilot off)
#   JANUS_AI_API_KEY           bearer token for the endpoint, if it needs one  (none)
#   JANUS_AI_TIMEOUT_S         time limit of one diagnosis request, seconds    (120)
# -----------------------------------------------------------------------------
