# Only what the Dockerfile copies: agent/, backend/, frontend/, res/
*
!agent/
!backend/
!frontend/
!res/

# ...minus local build output, caches and secrets
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/node_modules
**/.next
**/out
agent/dist
agent/janus-agent
frontend/public
**/.env
**/.env.*
**/*.pem
**/*.key
